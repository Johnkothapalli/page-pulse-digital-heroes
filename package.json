    "@types/node": "^20.19.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@opennextjs/cloudflare": "1.20.2",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "wrangler": "4.86.0"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "postcss": "8.5.23",
    "sharp": "0.35.3",
    "undici": "7.28.0",
